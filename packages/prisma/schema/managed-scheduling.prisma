// This model should be added to your main schema.prisma file

model ManagedSchedulingSetup {
  id          Int      @id @default(autoincrement())
  userId      Int
  provider    String   // "zoho" | "office365" | etc.
  externalId  String   // Provider-specific user ID
  status      String   @default("Not Started") // "Not Started" | "In Progress" | "Pending Completion" | "Completed"
  zoomUserId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, externalId])
  @@index([provider])
  @@index([status])
}